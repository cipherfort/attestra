{
  "name": "aap-frontend",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "types": "openapi-typescript ../schemas/api/openapi.yaml --default-non-nullable false -o src/api-types.ts",
    "types:check": "openapi-typescript ../schemas/api/openapi.yaml --default-non-nullable false -o /tmp/aap-api-types.ts && diff -q src/api-types.ts /tmp/aap-api-types.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
