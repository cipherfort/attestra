{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipherfort.github.io/attestra/schemas/catalogue/controls.schema.json",
  "title": "AppSec control catalogue",
  "type": "object",
  "required": ["catalogue_version", "defaults", "controls"],
  "additionalProperties": false,
  "$defs": {
    "tierRank": { "type": "string", "enum": ["1", "2", "3", "4"] },
    "requirementLevel": { "enum": ["mandatory", "recommended", "n/a"] },
    "confidence": { "enum": ["C0", "C1", "C2", "C3", "M1", "M2"] },
    "perTierInt": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/tierRank" },
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "max_days": { "$ref": "#/$defs/perTierInt" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "domain", "objective_type", "description", "rationale", "applicability", "mappings", "assessment", "proof", "implementation", "remediation"],
      "properties": {
        "id": { "type": "string", "pattern": "^ASC-(GOV|REQ|TM|ARC|SRC|BLD|DEP|TST|VUL|OPS)-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 5, "maxLength": 100 },
        "domain": { "enum": ["GOV", "REQ", "TM", "ARC", "SRC", "BLD", "DEP", "TST", "VUL", "OPS"] },
        "objective_type": {
          "description": "configuration = a setting IS the control; activity = something must execute; outcome = a measured result; process = a human process occurred",
          "enum": ["configuration", "activity", "outcome", "process"]
        },
        "description": { "type": "string" },
        "rationale": { "type": "string" },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiers"],
          "properties": {
            "tiers": {
              "type": "object",
              "propertyNames": { "$ref": "#/$defs/tierRank" },
              "additionalProperties": { "$ref": "#/$defs/requirementLevel" }
            },
            "conditions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" } }
          }
        },
        "mappings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "samm": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stream", "level"],
                "properties": {
                  "stream": { "type": "string", "pattern": "^[GDIVO]-[A-Z]{2}-[AB]$" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 3 }
                }
              }
            },
            "asvs": { "type": "array", "items": { "type": "string", "pattern": "^V[0-9]{1,2}(\\.[0-9]+){0,2}$" } },
            "ssdf": { "type": "array", "items": { "type": "string", "pattern": "^(PO|PS|PW|RV)\\.[0-9]\\.[0-9]$" } },
            "csf": { "type": "array", "items": { "type": "string", "pattern": "^(GV|ID|PR|DE|RS|RC)\\.[A-Z]{2}-[0-9]{2}$" } },
            "other": { "type": "array", "items": { "type": "string" } }
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "evaluator", "evidence_types", "min_confidence"],
          "properties": {
            "mode": { "enum": ["automated", "manual", "hybrid"] },
            "evaluator": { "type": "string", "pattern": "^[a-z_]+@[0-9]+$" },
            "evidence_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "min_confidence": {
              "oneOf": [
                { "$ref": "#/$defs/confidence" },
                {
                  "type": "object",
                  "propertyNames": { "$ref": "#/$defs/tierRank" },
                  "additionalProperties": { "$ref": "#/$defs/confidence" }
                }
              ]
            },
            "params": { "type": "object" }
          }
        },
        "proof": { "type": "string", "description": "How the organisation proves this control is actually operating" },
        "implementation": { "type": "string" },
        "remediation": { "type": "string" },
        "exception": { "$ref": "#/$defs/exception" },
        "owner": { "type": "string" },
        "review_months": { "type": "integer", "minimum": 1, "maximum": 36 },
        "notes": { "type": "string" }
      }
    }
  },
  "properties": {
    "catalogue_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "review_months", "exception"],
      "properties": {
        "owner": { "type": "string" },
        "review_months": { "type": "integer" },
        "exception": { "$ref": "#/$defs/exception" }
      }
    },
    "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
  }
}
