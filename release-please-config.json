{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.1.0",
      "extra-files": [
        { "type": "toml", "path": "backend/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" },
        { "type": "yaml", "path": "charts/fortproof/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "charts/fortproof/Chart.yaml", "jsonpath": "$.appVersion" }
      ]
    }
  }
}
